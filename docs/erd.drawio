        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    ISSUE_CATEGORY ||--o{ TECHNICIAN_SKILL : \&quot;phan loai ky nang\&quot;\n    TECHNICIAN ||--o{ TECHNICIAN_SKILL : \&quot;co ky nang\&quot;\n\n    DEVICE ||--o{ TICKET : \&quot;duoc tiep nhan\&quot;\n    TECHNICIAN o|--o{ TICKET : \&quot;duoc phan cong\&quot;\n    ISSUE_CATEGORY ||--o{ TICKET : \&quot;phan loai su co\&quot;\n\n    TICKET ||--o{ APPOINTMENT : \&quot;co lich hen\&quot;\n    TECHNICIAN ||--o{ APPOINTMENT : \&quot;thuc hien lich hen\&quot;\n\n    TICKET ||--o{ TICKET_STATUS_LOG : \&quot;co lich su\&quot;\n\n    ISSUE_CATEGORY {\n        INT category_id PK\n        VARCHAR category_name UK\n        VARCHAR default_priority\n        TINYINT is_active\n    }\n\n    TECHNICIAN {\n        BIGINT technician_id PK\n        BIGINT employee_id UK\n        VARCHAR full_name\n        BIGINT center_id\n        VARCHAR level\n        TINYINT is_active\n    }\n\n    DEVICE {\n        BIGINT device_id PK\n        BIGINT customer_id\n        VARCHAR device_name\n        VARCHAR serial_no UK\n        DATE purchase_date\n        SMALLINT warranty_months\n    }\n\n    TECHNICIAN_SKILL {\n        BIGINT technician_id PK, FK\n        INT category_id PK, FK\n        SMALLINT proficiency\n    }\n\n    TICKET {\n        BIGINT ticket_id PK\n        VARCHAR ticket_code UK\n        BIGINT customer_id\n        BIGINT device_id FK\n        BIGINT center_id\n        BIGINT technician_id FK\n        INT category_id FK\n        TEXT issue_desc\n        VARCHAR priority\n        VARCHAR status\n        DATETIME received_at\n        DATETIME due_date\n        DATETIME closed_at\n    }\n\n    APPOINTMENT {\n        BIGINT appointment_id PK\n        BIGINT ticket_id FK\n        BIGINT technician_id FK\n        DATETIME appointment_time\n        VARCHAR status\n        DATETIME created_at\n        DATETIME active_tech_time\n    }\n\n    TICKET_STATUS_LOG {\n        BIGINT log_id PK\n        BIGINT ticket_id FK\n        VARCHAR from_status\n        VARCHAR to_status\n        BIGINT changed_by\n        VARCHAR change_reason\n        DATETIME changed_at\n    }\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FvYLed2Ksb3VcHB_6AW8-375">
