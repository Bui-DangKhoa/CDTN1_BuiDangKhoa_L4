<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <contextName>smart-crm-technician-scheduling</contextName>

    <!-- Appender ghi log chuẩn JSON ra STDOUT (Bao gồm ISO 8601, requestId, che SĐT QT-15) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.mekongmobile.smartcrm.config.JsonMaskingLayout" />
        </encoder>
    </appender>

    <!-- Mức log cấu hình qua biến môi trường LOG_LEVEL, mặc định INFO -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE_JSON" />
    </root>

    <logger name="com.mekongmobile.smartcrm" level="${APP_LOG_LEVEL:-DEBUG}" />
    <logger name="org.hibernate.SQL" level="${SQL_LOG_LEVEL:-WARN}" />
</configuration>
